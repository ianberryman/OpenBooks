# OpenBooks environment.
#
#   cp .env.example .env && docker compose up
#
# The values below are the self-host defaults and work as-is against the Compose
# stack. Change the two passwords and the session secret before exposing
# anything.
#
# ── How providers are selected ───────────────────────────────────────────────
#
# Spec §3 requires every external dependency to sit behind an interface with two
# implementations: one hosted (AWS) and one self-host. Which implementation runs
# is decided by a *_PROVIDER variable, and each choice brings its own required
# variables with it.
#
#   selector             hosted                self-host
#   QUEUE_PROVIDER       sqs                   in-process
#   STORAGE_PROVIDER     s3                    local
#   SECRETS_PROVIDER     aws-secrets-manager   env
#   EMAIL_PROVIDER       ses                   smtp
#   BANK_FEED_PROVIDER   csv-ofx               csv-ofx
#
# The whole environment is validated once at startup. Selecting a provider
# without setting what it needs is a startup failure naming the provider, the
# selector that chose it, and every missing variable — the process refuses to
# start rather than failing later, on the first upload or the first email.
#
# Every variable here is declared in packages/server/src/config/env.ts. Nothing
# outside that module reads the environment, so a variable absent from the schema
# has no effect no matter where it is set.
#
# An empty value means "unset": the default applies, or startup fails if the
# variable is required. Comment a line out or leave it blank — same thing.

# ── Process ──────────────────────────────────────────────────────────────────
# One image, three roles (spec §2.5). Compose runs `migrate` to completion before
# starting `api`; migrations never run on API boot (spec §12).
# api | worker | migrate
OPENBOOKS_ROLE=api
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# The application connects only as openbooks_app, which holds SELECT/INSERT and
# is denied UPDATE/DELETE on journals and journal_lines. Ledger immutability is
# a database grant, not application discipline (spec §12).
# Host must match the MySQL service name in docker-compose.yml.
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_USER=openbooks_app
DATABASE_PASSWORD=change-me-app
DATABASE_NAME=openbooks
DATABASE_POOL_SIZE=10

# ── Sessions (spec §5) ───────────────────────────────────────────────────────
# Opaque session tokens in an HttpOnly cookie. Generate the secret with
# `openssl rand -hex 32`; minimum 32 characters.
SESSION_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
# Must be true anywhere the app is served over TLS. false only because the
# Compose quickstart serves plain HTTP on localhost, where a Secure cookie is
# never sent back.
SESSION_COOKIE_SECURE=false
# Leave unset unless the API and the web app are on different subdomains.
SESSION_COOKIE_DOMAIN=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call this API, as
# scheme://host[:port] with no trailing slash. Leave unset — as the Compose
# quickstart does — for any same-origin deployment: one hostname serving both
# the bundle and /v1, which is what a reverse proxy in front of this stack
# gives you. Set it only when the two are on different hostnames.
#
# "*" is rejected. Every request here carries the session cookie, and a browser
# refuses a wildcard on a credentialed request, so accepting one would only
# move the failure to run time.
#
# Setting this requires SESSION_COOKIE_DOMAIN, and every origin listed must sit
# inside it. The session cookie is SameSite=Lax: a browser withholds it from any
# origin not on the same site as this API, so an allowlist the cookie cannot
# follow produces a 401 on every request and no CORS error to explain it.
# Startup refuses that combination rather than serving it.
#
#   CORS_ALLOWED_ORIGINS=https://app.example.com
#   SESSION_COOKIE_DOMAIN=example.com
CORS_ALLOWED_ORIGINS=

# ── Provider selection ───────────────────────────────────────────────────────
QUEUE_PROVIDER=in-process
STORAGE_PROVIDER=local
SECRETS_PROVIDER=env
EMAIL_PROVIDER=smtp
BANK_FEED_PROVIDER=csv-ofx

# ── AWS (hosted providers only) ──────────────────────────────────────────────
# Required by sqs, s3, aws-secrets-manager, and ses. Credentials themselves are
# never environment variables in the hosted deployment: the task role supplies
# them.
AWS_REGION=

# ── Queue ────────────────────────────────────────────────────────────────────
# in-process: no configuration; jobs run in the API process.
# sqs:        SQS_QUEUE_URL and AWS_REGION.
SQS_QUEUE_URL=

# ── Document storage ─────────────────────────────────────────────────────────
# local: STORAGE_LOCAL_PATH — must be a writable volume, not container-local, or
#        attachments vanish on redeploy.
# s3:    S3_BUCKET and AWS_REGION.
STORAGE_LOCAL_PATH=/var/lib/openbooks/storage
S3_BUCKET=

# ── Secrets ──────────────────────────────────────────────────────────────────
# env:                 secrets are the variables in this file.
# aws-secrets-manager: SECRETS_MANAGER_PREFIX and AWS_REGION.
SECRETS_MANAGER_PREFIX=

# ── Email ────────────────────────────────────────────────────────────────────
# smtp: EMAIL_FROM_ADDRESS plus SMTP_HOST/PORT/USER/PASSWORD.
# ses:  EMAIL_FROM_ADDRESS and AWS_REGION.
# Nothing in M1 sends email; the defaults below just satisfy validation. Point
# them at a local relay (Mailpit on 1025, say) when a feature starts sending.
EMAIL_FROM_ADDRESS=openbooks@localhost
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=openbooks
SMTP_PASSWORD=change-me-smtp

# ── Bank feeds ───────────────────────────────────────────────────────────────
# csv-ofx reads an uploaded file and needs no configuration. Banking is M4.

# ── Migration credentials (OPENBOOKS_ROLE=migrate only) ──────────────────────
# Spec §12 splits the database identity in two. DATABASE_USER above is
# openbooks_app, which holds no DDL rights and — crucially — no UPDATE or DELETE
# on `journals` and `journal_lines`, which is what makes the ledger append-only
# at the database level rather than by convention.
#
# Schema changes therefore need a second identity. Config requires these two
# variables for the migrate role and for no other role, so an api or worker
# process never holds a credential that could alter the schema. `yarn codegen`
# uses them too: introspection has to see the whole schema.
DATABASE_MIGRATOR_USER=openbooks_migrator
DATABASE_MIGRATOR_PASSWORD=change-me-migrator

# ── Compose only ─────────────────────────────────────────────────────────────
# Read by docker-compose.yml and the MySQL init SQL, never by the application.
MYSQL_ROOT_PASSWORD=change-me-root
