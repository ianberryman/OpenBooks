{
  "name": "@openbooks/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "OpenBooks Fastify API, MCP server, and worker. One image, three roles.",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/entrypoints/api.ts",
    "build": "node ../../scripts/build-server.mjs",
    "start": "node ../../dist/server/main.js",
    "migrate": "tsx src/entrypoints/migrate-cli.ts up",
    "migrate:down": "tsx src/entrypoints/migrate-cli.ts down",
    "migrate:status": "tsx src/entrypoints/migrate-cli.ts status",
    "codegen": "node ../../scripts/codegen.mjs",
    "spec": "tsx src/entrypoints/spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1095.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@openbooks/plugin-api": "workspace:*",
    "@openbooks/shared-types": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.4",
    "mysql2": "^3.23.1",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.0.4",
    "@types/node": "^22.15.0",
    "fast-check": "^4.9.0",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.1.3",
    "testcontainers": "^12.0.4"
  }
}
