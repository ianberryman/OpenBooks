# OpenBooks CI — OB-027, extended for M2 by OB-056.
#
# ROADMAP D-09: GitHub Actions, not the GitLab CI named in spec §3. The repository is on
# GitHub, so a GitLab pipeline would be unverifiable — same stages, different runner. If
# the repo ever moves, this is a mechanical port of one file.
#
# Operator setup (secrets, variables, runner requirements, expected cost) is in
# docs/ci.md. Read that first if you are wiring this repo up rather than maintaining it.
#
# The gates here are not arbitrary; each one is a spec or ROADMAP commitment:
#
#   static         spec §11 A11 — no float arithmetic on money paths, lint-enforced
#                  ROADMAP B9 / D-24 — no component names a raw colour, lint-enforced
#   drift-spec     spec §12 A10 — OpenAPI drift is a build failure; artifact published
#   drift-schema   generated.ts must match the migrations, proven against a live schema
#   test           spec §11 — real MySQL only. Never SQLite, never mocks.
#   web            M2 — the client bundles, and its component contract holds (OB-056)
#   e2e            ROADMAP B1 / D-26 — a month of books in a real browser (OB-055)
#   parity         ROADMAP A6 — the grant split must be byte-identical across environments
#   build          spec §2.5 — one image, three roles; it has to actually build
#   terraform      D-05 — written, never applied, so validate only and non-blocking
#   publish-image  the deploy path, inert until an operator supplies AWS access
name: CI

# ── TRIGGERS ARE DELIBERATELY DISABLED ───────────────────────────────────────────────
#
# This workflow runs ONLY when someone starts it by hand (Actions → CI → Run workflow,
# or `gh workflow run ci.yml --ref <branch>`). Nothing fires on push or on a pull
# request. That is a deliberate decision for this repository's current state, not an
# oversight and not an incomplete file.
#
# TO RE-ENABLE AUTOMATIC RUNS: delete the `#` from the `push:` and `pull_request:`
# blocks below. That is the entire change — every job, gate, cache key and condition
# already works unchanged under those events, and they are written out here rather than
# omitted precisely so nobody has to reconstruct what they should have been.
#
# The one behaviour that shifts when you do: `publish-image` is gated on
# `github.ref == 'refs/heads/develop'`. Under `push` that means "merged to develop",
# which is what OB-027 asks for. Under `workflow_dispatch` it means "somebody dispatched
# this run from develop" — the same branch condition, a human instead of a merge.
on:
  workflow_dispatch:
  # push:
  #   branches: [develop]
  # pull_request:
  #   branches: [develop]

# Superseding a run of the same ref is always right here: every job is a gate on a
# commit, and an older commit's verdict is not interesting once a newer one exists.
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

# Least privilege by default. `publish-image` widens this for itself, and only to
# `id-token: write` for OIDC — no job in this file needs write access to the repository.
permissions:
  contents: read

jobs:
  # ── stage 1: lint, typecheck, dependency boundaries, formatting ──────────────────
  #
  # The four checks the root `yarn check` script leads with, in the same order, run as
  # separate steps so a failure names itself in the job summary. Deliberately not
  # `yarn check` — that also runs the drift gates and the test suite, which are their own
  # jobs here so they can run in parallel and fail independently.
  #
  # `yarn lint` is the enforcement point for ROADMAP A11 (no float arithmetic on money
  # paths) via @openbooks/eslint-plugin's no-float-money rule; `yarn lint:deps` is the
  # enforcement point for the module boundaries in .dependency-cruiser.cjs. Neither
  # touches the database.
  #
  # OB-056 adds `yarn lint:tokens` here rather than in a job of its own, because B9's
  # no-raw-color is the same construction as A11's no-float-money — D-24 says so in as
  # many words — and an enforcement point belongs next to its sibling.
  static:
    name: Static analysis
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      # Prettier formats YAML too, including this file. `--check` fails rather than
      # rewrites, which is the only useful behaviour in CI.
      - name: Formatting
        run: node "$YARN" format:check

      - name: ESLint
        run: node "$YARN" lint

      # ROADMAP B9, the acceptance criterion this step exists to make answerable: "no
      # component names a raw colour, spacing, or radius — tokens only, lint-enforced."
      #
      # `yarn lint` above already runs the rule, so this step is not here to catch a hex
      # that step would miss. It is here because B9 has two halves and only one of them
      # had a check: the rule reports correctly (proven by
      # packages/eslint-plugin/test/no-raw-color.test.ts) AND eslint.config.js still binds
      # it to the web sources at severity `error`. Drop the config block and every gate in
      # this file stays green while B9 stops being held. `yarn lint:tokens` asserts the
      # binding with `eslint --print-config`, then runs the rule under this name so a
      # violation reports as a B9 failure rather than as one line of a repo-wide lint.
      # The script carries the full argument.
      - name: Token layer (B9)
        run: node "$YARN" lint:tokens

      - name: Dependency boundaries
        run: node "$YARN" lint:deps

      # Runs per workspace, topologically, so a package's dependents typecheck against
      # its real declarations rather than a stale build.
      - name: Types
        run: node "$YARN" typecheck

  # ── stage 3: both spec drift gates, and the published artifact ───────────────────
  #
  # Spec §12 makes spec drift a build failure (ROADMAP A10). Two gates chained, because
  # they catch different staleness:
  #
  #   yarn spec:check     routes → openapi.json
  #   yarn client:check   openapi.json → packages/web/src/api/schema.d.ts
  #
  # Order matters only for the error message: run the other way round and a route change
  # reports as client drift, so the fix looks like `codegen` when it is `spec`. The root
  # `yarn drift` runs both in this order; they are split into two steps here so the job
  # log says which half failed without anyone reading the message.
  #
  # Neither needs a database — `spec.ts` builds the Fastify app with placeholder config
  # and never connects, and `check-client-drift.mjs` reads a committed JSON file.
  drift-spec:
    name: Spec drift + OpenAPI artifact
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      - name: Routes → openapi.json
        run: node "$YARN" spec:check

      # Regenerates the typed client into the working tree and restores it afterwards,
      # by design (see the header of check-client-drift.mjs). Nothing downstream in this
      # job reads packages/web, so the round trip is invisible here.
      - name: openapi.json → typed web client
        run: node "$YARN" client:check

      # Spec §12: the spec is published as a build artifact on every run.
      #
      # `always()` so a failed gate still publishes. That is the useful case: the
      # artifact is then the committed (stale) document, which is exactly what you want
      # to diff against the one the routes now produce. The gate above is what makes a
      # green run's artifact trustworthy; this step only makes it available.
      - name: Publish openapi.json
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: openapi-spec
          path: openapi.json
          if-no-files-found: error

  # ── stage 4: schema and codegen drift, against a real migrated database ──────────
  #
  # `packages/server/src/db/generated.ts` is committed and is the whole basis of Kysely's
  # type safety. A migration whose types were never regenerated leaves compile-time
  # guarantees as decoration — the types keep describing the previous schema and still
  # typecheck. `static` cannot catch that. This job is the gate that does.
  #
  # It needs a live, migrated database: kysely-codegen introspects information_schema, as
  # the migrator user, because introspection has to see the whole schema and the
  # application user cannot (spec §12 splits the identity in two).
  #
  # MySQL comes up through docker-compose.yml rather than a GitHub service container, for
  # a reason that is not convenience: the two users and the grant split are created by
  # docker/mysql-init/*.sql, mounted into /docker-entrypoint-initdb.d. Service containers
  # start BEFORE `actions/checkout` runs, so that directory would not exist yet and the
  # init scripts would silently not run — leaving no openbooks_migrator to connect as.
  # Compose after checkout also means this job exercises the same bootstrap path a
  # self-hosting operator gets, which is what makes ROADMAP A6 mean the same thing here
  # as it does locally.
  drift-schema:
    name: Schema/codegen drift
    runs-on: ubuntu-latest
    # Both `yarn migrate` and `yarn codegen` read the environment: migrate through the
    # real config module (which requires a full, valid environment for the migrate role,
    # by design — see packages/server/src/config/env.ts), codegen directly. Values follow
    # .env.example, with two deliberate departures:
    #
    #   DATABASE_HOST=127.0.0.1  — .env.example says `mysql`, the Compose service name.
    #                              These commands run on the runner, not in the network,
    #                              and reach MySQL through the published port.
    #   SESSION_SECRET           — a throwaway. Nothing here signs a cookie; the schema
    #                              only requires ≥32 characters.
    #
    # The two passwords are NOT free choices. They are literals in
    # docker/mysql-init/01-users.sql, because MySQL's entrypoint does not expand
    # environment variables in *.sql. Changing them here without changing that file
    # yields "Access denied for user 'openbooks_app'".
    env:
      OPENBOOKS_ROLE: migrate
      NODE_ENV: production
      LOG_LEVEL: info
      DATABASE_HOST: 127.0.0.1
      DATABASE_PORT: 3306
      DATABASE_NAME: openbooks
      DATABASE_USER: openbooks_app
      DATABASE_PASSWORD: change-me-app
      DATABASE_MIGRATOR_USER: openbooks_migrator
      DATABASE_MIGRATOR_PASSWORD: change-me-migrator
      SESSION_SECRET: ci-does-not-sign-cookies-0123456789abcdef
      STORAGE_LOCAL_PATH: /tmp/openbooks-storage
      EMAIL_FROM_ADDRESS: ci@example.invalid
      SMTP_HOST: localhost
      SMTP_PORT: 1025
      SMTP_USER: ci
      SMTP_PASSWORD: ci
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      # `--wait` blocks on the service's own healthcheck, which docker-compose.yml
      # deliberately probes over TCP rather than the unix socket: the entrypoint runs the
      # init scripts against a socket-only temporary server, so a socket ping reports
      # healthy while openbooks_app does not exist yet. Without `--wait` the migrate step
      # below would race that and fail with "Access denied".
      - name: Start MySQL
        run: docker compose up -d --wait mysql

      # Spec §12 and ROADMAP A12: migrations are a discrete job. This is the same code
      # path the migrate role runs in production, connecting as openbooks_migrator.
      - name: Migrate
        run: node "$YARN" migrate

      # Regenerate, then diff. `yarn codegen --verify` (kysely-codegen's own check mode)
      # would answer the same question, but a regenerate-and-diff prints the actual
      # change — and "add the column to the override table in scripts/codegen.mjs" is
      # only obvious once you can see which column and which type.
      - name: Regenerate generated.ts
        run: node "$YARN" codegen

      - name: Fail on schema/type drift
        run: |
          if ! git diff --exit-code -- packages/server/src/db/generated.ts; then
            echo "::error file=packages/server/src/db/generated.ts::generated.ts does not match the migrated schema. Run \`yarn codegen\` against a migrated database and commit the result. If a new BIGINT or DATE column appeared above, it also needs an entry in the override table in scripts/codegen.mjs — otherwise the types will quietly disagree with what the driver returns."
            exit 1
          fi

      # MySQL has no transactional DDL, so a migration that fails partway leaves a
      # half-applied schema and the container log is the only place the original error
      # is legible.
      - name: MySQL logs
        if: failure()
        run: docker compose logs mysql

  # ── stage 2: the test suite, against real MySQL ──────────────────────────────────
  #
  # Spec §11 forbids SQLite and mocks outright: the guarantees M1 exists to prove —
  # ledger immutability at the grant level, composite-key tenancy, CHECK constraints —
  # do not exist anywhere except in MySQL. So the suite needs a Docker-enabled runner,
  # which `ubuntu-latest` is. That cost is accepted, not worked around.
  #
  # The suite is cheap because of how packages/server/test is built: globalSetup starts
  # ONE container for the whole project (~4.5s) and hands connection parameters to test
  # files through provide/inject, and `fileParallelism: false` keeps files from
  # interleaving writes against the shared schema. See packages/server/test/README.md.
  test:
    name: Tests (real MySQL)
    runs-on: ubuntu-latest
    env:
      # Ryuk is testcontainers' cleanup sidecar. It exists to reap containers when the
      # host outlives the test run — which a GitHub runner never does, since the VM is
      # destroyed with everything on it. Disabling it skips one image pull, and
      # globalTeardown stops the MySQL container itself. packages/server/test/README.md
      # documents this as the supported way out; it is also the documented fix for the
      # hang when a Docker credential helper cannot reach Docker Hub.
      TESTCONTAINERS_RYUK_DISABLED: 'true'
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      # Pulled explicitly, and pinned to the tag packages/server/test/db/container.ts
      # hardcodes, so the pull shows up as its own timed step. Inside globalSetup it
      # would instead be an unexplained ~20s of a 180s hookTimeout, and a slow registry
      # would look like a slow harness.
      - name: Pre-pull MySQL image
        run: docker pull mysql:8.4

      - name: Vitest
        run: node "$YARN" test

  # ── stage 2b: the web client — bundle and component contract (OB-056) ────────────
  #
  # Both commands below also run inside slower jobs: `yarn build` in `build` bundles the
  # web client too, and `yarn test` in `test` includes the `web` Vitest project. This job
  # is that overlap on purpose, and the overlap is what it is for:
  #
  #   1. Neither of those jobs can report without Docker. `test` cannot start until
  #      mysql:8.4 is pulled and `build` is dominated by the image build, and a Docker Hub
  #      pull that hangs is a failure mode this repository has hit and written down twice
  #      — packages/server/test/README.md and packages/e2e/scripts/start-stack.mjs. A
  #      Tailwind or component regression should not be invisible on a day the registry is
  #      unwell.
  #   2. Feedback time. This job is Docker-free and finishes in roughly the install time,
  #      against ~5 minutes for `build`, and the M2 surface is the web client.
  #
  # The bundle step is not decoration. A defect in the token layer made Tailwind emit
  # `@media (width >= var(…))` for any source file containing the bare word `container`,
  # which the CSS minifier rejects — the build died while typecheck, lint and the whole
  # suite passed. Nothing but a bundler run can see that class of failure, which is also
  # why `yarn build` is now part of `yarn check` (see docs/ci.md).
  #
  # The component suite is jsdom (packages/web/vite.config.ts explains the choice). It is
  # not a browser and does not discharge B1 — `e2e` below is what does.
  web:
    name: Web bundle + components
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      - name: Bundle the client (Vite + Tailwind)
        run: node "$YARN" build:web

      - name: Component suite (jsdom)
        run: node "$YARN" test:web

  # ── stage 6: the B1 narrative in a real browser (OB-055) ─────────────────────────
  #
  # ROADMAP B1 is the one acceptance criterion that cannot be proven below the browser,
  # and D-26 fixes how: one Playwright narrative against the real Compose stack, not a
  # suite. Everything else stays with the property and enforcement suites, because e2e is
  # the slowest and most brittle test available.
  #
  # THE SUITE LANDED ALONGSIDE THIS TICKET, so this job runs two root scripts and nothing
  # else. Both are thin delegations added by OB-056 to the root package.json, and they are
  # the coupling to reconcile if OB-055's package renames anything:
  #
  #   yarn e2e          → yarn workspace @openbooks/e2e test:e2e       (playwright test)
  #   yarn e2e:install  → yarn workspace @openbooks/e2e test:e2e:install
  #
  # Nothing about the stack is CI's business. `packages/e2e/playwright.config.ts` declares
  # both servers as Playwright `webServer` entries — `scripts/start-stack.mjs` brings up
  # Compose `mysql`, runs migrations to completion, then the API, and a second entry runs
  # Vite — so `yarn e2e` on a laptop and `e2e` here are the same thing. Every other gate
  # in this repo is one repo script that runs the same way locally; splitting the stack
  # across the workflow would have broken that.
  #
  # Browser installation is the one step kept separate, because it is machine provisioning
  # rather than a test: a laptop has the browsers already and a fresh runner never does.
  #
  # The probe stays now that the suite exists. It is what makes this job safe on a ref
  # where OB-055 is absent — a bisect, a branch cut before it landed, a revert:
  #
  #   packages/e2e/package.json absent   → skip with a ::notice, green. A job that fails
  #                                        red for code that is not on the ref teaches
  #                                        people to ignore red.
  #   present, but no root `e2e` script  → FAIL, loudly, naming the mismatch. That is not
  #                                        an absence, it is an integration defect, and a
  #                                        silent skip would drop B1 out of CI without
  #                                        anything going red — the same failure mode the
  #                                        token gate one job above exists to close.
  #
  # UNVERIFIED, and the only job in this file that is. Every other job was executed
  # locally, in order, before it was written. This one was not: OB-055 was still in flight
  # in the working tree while OB-056 was written, and `yarn e2e` starts Compose and drives
  # a browser, which would have interfered with the agent building it. What *was* run
  # locally is the probe script below, in all four of its branches, against sandboxes.
  # The first real execution of this job is its first dispatch.
  e2e:
    name: End-to-end (Playwright)
    runs-on: ubuntu-latest
    # Compose plus a browser is the one thing here that can hang rather than fail: a
    # webServer that never becomes ready waits forever, and GitHub's default cap is six
    # hours of a runner doing nothing. 30 minutes is well clear of a cold image build.
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      # Before `actions/setup`, so the skip costs a checkout rather than a full install.
      - id: probe
        name: Is the e2e suite present?
        run: |
          if [[ ! -f packages/e2e/package.json ]]; then
            echo "present=false" >> "$GITHUB_OUTPUT"
            echo "::notice title=E2E skipped::packages/e2e is not on this ref (OB-055, ROADMAP B1). See docs/ci.md."
            exit 0
          fi

          echo "present=true" >> "$GITHUB_OUTPUT"

          has_script() {
            node -e "const fs=require('node:fs');const s=JSON.parse(fs.readFileSync('package.json','utf8')).scripts||{};process.exit(s['$1']?0:1)"
          }

          if ! has_script e2e; then
            echo "::error file=package.json::packages/e2e exists but the root package.json has no \`e2e\` script. The e2e job runs \`yarn e2e\` and nothing else; add that delegation, or change this job to the name packages/e2e now uses."
            exit 1
          fi

          if has_script e2e:install; then
            echo "install=true" >> "$GITHUB_OUTPUT"
          else
            echo "install=false" >> "$GITHUB_OUTPUT"
            echo "::notice title=No e2e:install::Root package.json has no \`e2e:install\` script, so \`yarn e2e\` is expected to install Playwright's browsers itself."
          fi

      - if: steps.probe.outputs.present == 'true'
        uses: ./.github/actions/setup

      # Same reasoning as the `test` job's pre-pull, and it matters more here: the pull
      # happens inside `start-stack.mjs`, which Playwright runs under a 180s `webServer`
      # timeout. A slow registry would surface as "the API never became ready" rather than
      # as what it is. The tag is docker-compose.yml's default for MYSQL_VERSION.
      - name: Pre-pull MySQL image
        if: steps.probe.outputs.present == 'true'
        run: docker pull mysql:8.4

      - name: Install Playwright browsers
        if: steps.probe.outputs.install == 'true'
        run: node "$YARN" e2e:install

      - name: The B1 narrative
        if: steps.probe.outputs.present == 'true'
        run: node "$YARN" e2e

      # Both paths are read from packages/e2e/playwright.config.ts, not assumed:
      # `outputFolder: 'playwright-report'` for the HTML report, and `test-results/` is
      # where `trace: 'retain-on-failure'` and `screenshot: 'only-on-failure'` write. The
      # trace is the artifact worth having — a failed narrative is thirty user actions and
      # the trace viewer is the only practical way to see which one broke.
      #
      # `if-no-files-found: ignore` because a green run leaves no test-results directory
      # at all, and a passing narrative must not be turned red by a missing screenshot.
      - name: Playwright report and traces
        if: always() && steps.probe.outputs.present == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: |
            packages/e2e/playwright-report
            packages/e2e/test-results
          if-no-files-found: ignore

      # The stack the narrative ran against, when it did not pass. D-26 puts real MySQL
      # and the real image under the browser, so the interesting error is as often in a
      # container log as in the trace.
      - name: Compose logs
        if: failure() && steps.probe.outputs.present == 'true'
        run: docker compose logs --no-color || true

  # ── stage 9: DB bootstrap parity ─────────────────────────────────────────────────
  #
  # infra/db-bootstrap/02-grants.sql and docker/mysql-init/02-grants.sql must be
  # byte-identical. ROADMAP records the risk plainly: the dual-user requirement touches
  # four environments, and a mismatch makes acceptance A6 (UPDATE/DELETE on journals
  # denied as openbooks_app) pass locally and mean nothing in production. The script also
  # guards 01-users-rds.sql against shell metacharacters, because the hosted db-bootstrap
  # task streams that file through an UNQUOTED heredoc — a backtick in a prose comment
  # became command substitution once already.
  #
  # This used to pass vacuously on a missing Compose copy. It does not any more, and it
  # stays in CI as a blocking gate for that reason.
  #
  # Its own job because it needs nothing: no Node, no Yarn, no Docker. Checkout and bash.
  parity:
    name: DB bootstrap parity
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      # Invoked through `bash` rather than executed directly so the gate does not depend
      # on the file mode surviving every future checkout and packaging path.
      - name: Compare the grant split across environments
        run: bash infra/scripts/check-db-bootstrap-parity.sh

  # ── stage 5: build ───────────────────────────────────────────────────────────────
  #
  # Two builds, deliberately, because they fail for different reasons.
  #
  # `yarn build` is the repo's own definition of the production build — esbuild bundling
  # the server to dist/server/main.js plus Vite bundling the web client. It catches a
  # bundler-visible problem (an unresolved alias, a package that cannot be externalised)
  # that typecheck does not. It stays whole here rather than being split per workspace,
  # because the point of this step is that the command the repo calls "the build" works;
  # the `web` job runs the client half on its own for the reasons given there.
  #
  # `docker build` catches everything the Dockerfile knows that the host does not: the
  # manifest-only install layer still resolving, `yarn install --immutable` holding on
  # linux with a lockfile authored on darwin-arm64, and `workspaces focus --production`
  # still leaving argon2/mysql2/pino on disk for the runtime stage to require. Spec §2.5
  # requires one image for all three roles, so if this stops building there is no deploy.
  build:
    name: Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: ./.github/actions/setup

      - name: Bundle server and web
        run: node "$YARN" build

      # Native to the runner (amd64) and never pushed — this step asks only "does the
      # image build". The artifact that gets deployed is arm64 and is built by
      # `publish-image`; see the note there and item 7 of infra/terraform/README.md.
      - name: Docker image
        run: docker build -t openbooks:ci-${{ github.sha }} .

  # ── stage 8: Terraform fmt and validate, non-blocking ────────────────────────────
  #
  # D-05: the IaC is committed, reviewed, and has never been applied. There is no AWS
  # account and no credentials, so `plan` is not available — it needs credentials for the
  # very first data source it evaluates. fmt + validate is the ceiling of what can be
  # checked, and infra/terraform/README.md is explicit that this proves the configuration
  # is well-formed and proves nothing about whether it applies.
  #
  # `continue-on-error: true` makes the job advisory: it reports, it does not block, and
  # it is not in `publish-image`'s `needs`. Remove that line when credentials exist and
  # this becomes a real gate.
  #
  # Note what this job does NOT do: run `plan`, or upload anything.
  # infra/terraform/README.md flags for OB-027 that a saved plan file leaks the RDS
  # master password ARN and the session secret, and must never be a build artifact.
  terraform:
    name: Terraform validate (advisory)
    runs-on: ubuntu-latest
    continue-on-error: true
    steps:
      - uses: actions/checkout@v4

      - uses: hashicorp/setup-terraform@v3
        with:
          # The constraint from infra/terraform/versions.tf, verbatim. setup-terraform
          # resolves a leading-`<` constraint against the release list, so this tracks
          # the newest Terraform the configuration actually permits instead of a pin
          # here that would silently become a second opinion about the version.
          terraform_version: '<2.0.0'
          # The wrapper exists to expose stdout/stderr as step outputs. Nothing here
          # consumes them, and it mangles the script's own output.
          terraform_wrapper: false

      # The script owns the details, including the one that is easy to get wrong:
      # `modules/edge` cannot be validated standalone because it declares a
      # `configuration_aliases` entry for the us-east-1 provider CloudFront's ACM
      # certificate needs. Validating it alone fails with "Provider configuration not
      # present", which is correct behaviour rather than a defect — so the script
      # validates the two ROOTS, and `terraform validate` on a root validates every
      # module it composes.
      - name: fmt -check and validate
        run: bash infra/scripts/tf-validate.sh

  # ── stage 7a: is there anything to push with? ────────────────────────────────────
  #
  # The `secrets` context cannot be read from a job-level `if:` — only from `env:` and
  # `with:` inside a step. So the presence check is a job that publishes a boolean, and
  # `publish-image` keys off that. Without this indirection the only ways to gate on a
  # secret are to fail the job or to make every step individually conditional, and OB-027
  # requires the push to skip cleanly instead.
  #
  # Cheap: one runner, a few seconds, no checkout.
  aws-preflight:
    name: AWS credentials preflight
    runs-on: ubuntu-latest
    outputs:
      configured: ${{ steps.probe.outputs.configured }}
    steps:
      - id: probe
        env:
          AWS_ROLE_ARN: ${{ secrets.AWS_ROLE_ARN }}
          AWS_REGION: ${{ vars.AWS_REGION }}
          ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY }}
        run: |
          missing=()
          [[ -n "${AWS_ROLE_ARN}" ]] || missing+=("secret AWS_ROLE_ARN")
          [[ -n "${AWS_REGION}" ]] || missing+=("variable AWS_REGION")
          [[ -n "${ECR_REPOSITORY}" ]] || missing+=("variable ECR_REPOSITORY")

          if [[ ${#missing[@]} -eq 0 ]]; then
            echo "configured=true" >> "$GITHUB_OUTPUT"
            echo "AWS access is configured; publish-image will run on develop."
            exit 0
          fi

          echo "configured=false" >> "$GITHUB_OUTPUT"
          # A notice, not a warning: for this repository "no AWS access" is the expected
          # state (D-05 — nothing has ever been deployed), and a yellow annotation on
          # every run trains people to ignore annotations.
          echo "::notice title=Image publish skipped::Not configured: ${missing[*]}. See docs/ci.md."

  # ── stage 7b: build and push the image to ECR ────────────────────────────────────
  #
  # WHAT AN OPERATOR MUST SET (docs/ci.md has the full walkthrough):
  #
  #   secrets.AWS_ROLE_ARN   IAM role for GitHub's OIDC provider to assume. Not an access
  #                          key — this job requests a short-lived token and never holds a
  #                          long-lived credential. infra/terraform/README.md lists this
  #                          role under what Terraform cannot create: bootstrapping the
  #                          identity that runs the pipeline is a chicken-and-egg problem.
  #   vars.AWS_REGION        The region the ECR repository lives in.
  #   vars.ECR_REPOSITORY    Repository name. `openbooks/server` is the default of
  #                          `ecr_repository_name` in infra/terraform/variables.tf, and
  #                          is deliberately not environment-prefixed so one image can be
  #                          promoted between environments by digest.
  #
  # WITH NONE OF THEM SET — the state of this repository today — `aws-preflight` reports
  # `configured=false`, this job is skipped (grey, not red), and the run is still green.
  # No name above is invented: each is checked by exactly one place in this file and
  # documented in exactly one place in docs/ci.md.
  #
  # WHEN IT RUNS: only from `develop`. Under the `push` trigger (commented out at the top
  # of this file) that reads as "on merge to develop", which is what OB-027 specifies.
  # Under `workflow_dispatch` it means a human dispatched this run with `develop`
  # selected — same branch condition, different initiator. It is also gated on every
  # blocking job above, so nothing reaches a registry that has not passed the drift
  # gates, the real-MySQL suite, the parity check and — once OB-055 lands — the B1
  # narrative. `e2e` is in that list while it still skips: a skipped job satisfies
  # `needs`, so naming it now costs nothing and means nobody has to remember to add it
  # on the day the suite that proves B1 starts running.
  publish-image:
    name: Push image to ECR
    needs: [static, drift-spec, drift-schema, test, web, e2e, parity, build, aws-preflight]
    if: needs.aws-preflight.outputs.configured == 'true' && github.ref == 'refs/heads/develop'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      # The OIDC token configure-aws-credentials exchanges for temporary credentials.
      # Granted here and nowhere else in this file.
      id-token: write
    steps:
      - uses: actions/checkout@v4

      # The task definitions in infra/terraform/modules/compute are ARM64, and item 7 of
      # infra/terraform/README.md names the consequence for this ticket directly: an
      # amd64 image dies at startup with an exec-format error. So the pushed artifact is
      # arm64 regardless of the runner's architecture.
      #
      # On an amd64 runner that means emulation, and emulating a full `yarn install` plus
      # two bundlers is slow — expect roughly 15-25 minutes against 4-6 native. If the
      # plan for this repository includes arm64 GitHub-hosted runners, switching this
      # job's `runs-on` to `ubuntu-24.04-arm` deletes both the QEMU step and the penalty.
      # Left on ubuntu-latest because that label resolves on every plan.
      - uses: docker/setup-qemu-action@v3
        with:
          platforms: arm64
      - uses: docker/setup-buildx-action@v3

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_ROLE_ARN }}
          aws-region: ${{ vars.AWS_REGION }}

      - id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      # Tagged with the commit SHA and nothing else. The ECR repository is created with
      # `image_tag_mutability = "IMMUTABLE"` (infra/terraform/modules/compute/ecr.tf) and
      # every task definition pins a tag, so a moving `develop` tag would both be
      # rejected by the registry and make "which code is running" unanswerable after the
      # fact.
      #
      # `--provenance=false`: buildx otherwise attaches an attestation manifest, turning
      # a single-platform push into an index. ECS pulls the tag directly and gains
      # nothing from it here, while the extra indirection is a class of pull failure
      # nobody wants to debug during a deploy.
      #
      # This does NOT deploy. Registering a migrate task revision from this digest and
      # running it before the api service rolls (spec §12, ROADMAP A12) is the deploy
      # pipeline's job, and there is nothing to deploy to yet (D-05). The contract it will
      # have to honour is documented at the top of
      # infra/terraform/modules/compute/tasks.tf.
      - name: Build and push (linux/arm64)
        env:
          IMAGE: ${{ steps.ecr.outputs.registry }}/${{ vars.ECR_REPOSITORY }}:${{ github.sha }}
        run: |
          docker buildx build \
            --platform linux/arm64 \
            --provenance=false \
            --tag "${IMAGE}" \
            --push \
            .
          echo "::notice title=Image pushed::${IMAGE}"
