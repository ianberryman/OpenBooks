{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // Strictness. Spec §3 requires TypeScript (strict); these are the settings
    // that make "strict" actually mean something.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "sourceMap": true,

    // Internal packages are consumed from source. The server is bundled with
    // esbuild for production, so there is no dist-vs-src resolution split.
    "paths": {
      "@openbooks/plugin-api": ["./packages/plugin-api/src/index.ts"],
      "@openbooks/plugin-api/*": ["./packages/plugin-api/src/*"],
      "@openbooks/shared-types": ["./packages/shared-types/src/index.ts"],
      "@openbooks/shared-types/*": ["./packages/shared-types/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "coverage"]
}
